<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ADR 0106 §4 of Kazo OS: the host trims this app when it publishes. -->
    <IsTrimmable>true</IsTrimmable>
    <!-- A Kazo OS app; read by the Debug profile of the kazoos-solution layout (ADR 0207). -->
    <KazoOsAppProject>true</KazoOsAppProject>
    <RootNamespace>OsX86.Feature</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      The Kazo package of Os-x86 (plan §1.1): a Feature (Kazo ADR 0260, work item 8). The Razor SDK
      is used for the static web assets only: wwwroot/ holds the JavaScript of the engine and the
      storage and the vendored v86, served at _content/OsX86.Feature/ in a host and in the installed
      package alike, since Kazo packs and serves only the app project's own resources (ADR 0206,
      ADR 0221; decision 290 B). No Razor component.
    -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Kazo.Os.AppSdk" Version="$(KazoOsVersion)" />
    <!-- Generates manifest.json after the build and checks the SDK boundary (KOSAPP0030). -->
    <PackageReference Include="Kazo.Os.App.Build" Version="$(KazoOsVersion)" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OsX86\OsX86.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OsX86.Tests" />
  </ItemGroup>
</Project>
