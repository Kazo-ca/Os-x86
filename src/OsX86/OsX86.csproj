<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>OsX86</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      x86-Lib (plan §1.1): the reusable implementation of Ix86. Engine, storage, network, share, agent,
      identity and VM registry live here. Its JavaScript and the vendored v86 are web resources of the
      Feature project (src/OsX86.Feature/wwwroot, served at _content/OsX86.Feature/): Kazo packs and
      serves only the resources of the app's own project (Kazo ADR 0206, 0221; decision 290 B).
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.JSInterop" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OsX86.Interface\OsX86.Interface.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OsX86.Tests" />
  </ItemGroup>
</Project>
