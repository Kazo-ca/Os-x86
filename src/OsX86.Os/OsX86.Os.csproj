<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!--
      ADR 0106, ADR 0113: Release publish trims the framework and the other trimmable libraries; the
      Kazo OS packages and every app are kept whole (roots added by Kazo.Os.App.Build).
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!--
      Kazo OS host (ADR 0047, ADR 0098 §2): the build aggregates the manifests of every app package
      below into this assembly, read back by HostAppCatalog.Load, and lazy-loads their assemblies.
      IsSystemApp="true" makes an app a system app (not uninstallable, dangerous capabilities granted).
      $(KazoOsVersion) comes from the submodule; in Debug the packages become its projects (ADR 0176 §4).
    -->
    <KazoOsAppHost>true</KazoOsAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Kazo.Os.App.Build" Version="$(KazoOsVersion)" PrivateAssets="all" />
    <PackageReference Include="Kazo.Os.Ecosystem.Host" Version="$(KazoOsVersion)" />
  </ItemGroup>

  <!--
    Work item 6b: the local origin of the images. Every pack built in images/build/<image>/pack/
    (never committed) is served at the same path, images/build/<image>/pack/ (manifest.json and
    chunks only, never published), and its expected manifest hash (the pack's manifest.sha256) is recorded as
    assembly metadata OsX86.DevPack = "<image>|<sha256>"; DevImages.cs turns them into the image
    catalog. OsX86DevImages=false leaves them out.
  -->
  <PropertyGroup>
    <_OsX86RepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..'))</_OsX86RepositoryRoot>
    <_OsX86DevPacks>$(_OsX86RepositoryRoot)images\build\</_OsX86DevPacks>
  </PropertyGroup>
  <ItemGroup Condition="'$(OsX86DevImages)' != 'false'">
    <_OsX86DevPackFile Include="$(_OsX86DevPacks)**\pack\manifest.json;$(_OsX86DevPacks)**\pack\chunk-*.bin"
                       RelativePath="images/build/%(RecursiveDir)%(Filename)%(Extension)" />
    <_OsX86DevPackHash Include="$(_OsX86DevPacks)**\pack\manifest.sha256" />
  </ItemGroup>
  <!--
    Static web assets whose content root is the repository: a linked Content item would be served
    from the project's wwwroot, where the file is not. Build only: never published.
  -->
  <Target Name="OsX86DevPackAssets" AfterTargets="ResolveProjectStaticWebAssets" Condition="'@(_OsX86DevPackFile)' != ''">
    <DefineStaticWebAssets CandidateAssets="@(_OsX86DevPackFile)"
                           RelativePathPattern="**"
                           SourceType="Discovered"
                           SourceId="$(PackageId)"
                           AssetKind="Build"
                           ContentRoot="$(_OsX86RepositoryRoot)"
                           BasePath="/">
      <Output TaskParameter="Assets" ItemName="_OsX86DevPackAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints CandidateAssets="@(_OsX86DevPackAsset)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
    <ItemGroup>
      <StaticWebAsset Include="@(_OsX86DevPackAsset)" />
    </ItemGroup>
  </Target>
  <Target Name="OsX86DevPackMetadata" BeforeTargets="GetAssemblyAttributes" Condition="'@(_OsX86DevPackHash)' != ''">
    <ItemGroup>
      <AssemblyMetadata Include="OsX86.DevPack" Value="$([System.String]::Copy('%(_OsX86DevPackHash.RecursiveDir)').Replace('\pack\', ''))|$([System.IO.File]::ReadAllText('%(_OsX86DevPackHash.FullPath)').Substring(0, 64))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The base apps. Add your own apps as ProjectReference or PackageReference items. -->
    <ProjectReference Include="..\OsX86.Feature\OsX86.Feature.csproj" />
    <PackageReference Include="Kazo.Os.Commands" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.Terminal" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.Settings" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.FileExplorer" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.Desktop" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.TextEditor" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.CodeEditor" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.SystemMonitor" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.ErrorLogViewer" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.WebServer" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.ThemeEditor" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.Store" Version="$(KazoOsVersion)" IsSystemApp="true" />
    <PackageReference Include="Kazo.Os.Apps.Browser" Version="$(KazoOsVersion)" />
    <PackageReference Include="Kazo.Os.Apps.Calculator" Version="$(KazoOsVersion)" />
    <PackageReference Include="Kazo.Os.Apps.KazoPaint" Version="$(KazoOsVersion)" />
    <PackageReference Include="Kazo.Os.Apps.IconViewer" Version="$(KazoOsVersion)" />
    <PackageReference Include="Kazo.Os.Apps.Diagnostic" Version="$(KazoOsVersion)" />
  </ItemGroup>

</Project>
